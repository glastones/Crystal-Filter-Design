    object Informations: TTabSheet
      Caption = 'Informations'
      ClientHeight = 358
      ClientWidth = 544
      object MemoInformations: TMemo
        Left = 8
        Height = 320
        Top = 8
        Width = 520
        Font.CharSet = ANSI_CHARSET
        Font.Color = clBlack
        Font.Height = -16
        Font.Name = 'Segoe UI'
        Font.Pitch = fpVariable
        Font.Quality = fqDraft
        Lines.Strings = (
          'This program has be made according to Anatol Sverev Filter Synthesis Handbook. '
          'It uses the approximations equations for the filter design. The problem with the parameter'
          'occurs when you try to calculate the Crystal parameters.'
          'In order to be accurate you must know the electrode area. When you know that you can estimate the static capacitance as the capacitance which occurs form the electrode area with dielectric the quartz crystal plus the holder capacitance. Only when you know both those parameters you can accurate calculate the filter. Those parameter are know only when you order the crystals from the manufacture. The crystal manufacture needs to know the crystal impedance the frequency and the motional capacitance and the cutting. For high frequency and good thermal stability the usual cutting is the AT-CUT.'
          'The frequency are fine for the filters but the calculations of the intermediate capacitance are not accurate. So inductance may need it in order to tune out any remaining capacitance. This will help to reduce the ripple. '
          ''
          ' This program made in my spare time so the development goes too slow. It is open source so the code is available to all in order to improve it in any aspect. It is made in Lazarus Free Pascal.'
        )
        ParentFont = False
        ReadOnly = True
        ScrollBars = ssAutoBoth
        TabOrder = 0
      end
    end
    object Instructions: TTabSheet
      Caption = 'Instructions'
      ClientHeight = 358
      ClientWidth = 544
      object memoInstructions: TMemo
        Left = 1
        Height = 360
        Top = 8
        Width = 551
        Alignment = taCenter
        Lines.Strings = (
          'In this program you must choose the filter type. That made from the first screen. The equations are valid for Butterworth (0 db ripple) and Chebysev filter (0.01db,0.1db,0.5db).'
          'The Crystal filter are narrow filter with maximum values of 0.1% of the center frequency. Those design  are rare to implement with traditional ways. The parallel crystals are the most usable technique.'
          'So choose wisely the center frequency and the  bandwidth which need it. As for the Ci you could use any value up to 20fP. Above that most of the manufacture  denied to made it. '
          'Always the input and the output impedance are calculated as ideal transformer. That is not possible. For that reason you could use the filter impedance and calculate your own impedance matching circuit. '
          'The most common technique is the series capacitor with a shunt inductance.'
        )
        ScrollBars = ssAutoBoth
        TabOrder = 0
      end
    end
